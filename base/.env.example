# Config for init_work.sh. Copy to ~/.env (or base/.env) and fill in.
# The file is sourced by bash, so shell quoting and $HOME work.

# One "<ip-or-host>[_<label>]" per line; each gets its own tmux window.
# Lines starting with # are skipped.
VMS="192.0.2.10_host-a
192.0.2.11_host-b
host-c.example.com"

# User for the ssh connections (default: local $USER).
SSH_USERNAME=user

# Starting directory of the dev window (default: ~/Documents/work/git_tree).
#DEV_DIR="$HOME/Documents/work/git_tree/project"

# Jump host that issues the SSH certificates; logged into before tmux starts.
# Leave unset to skip the certificate login.
#BASTION_HOST=bastion.example.com

# Space-separated private keys to ssh-add into the fresh agent.
#SSH_KEYS="~/.ssh/id_ed25519"

# Panes per host window (default 2).
#PANES_PER_HOST=2

# "false" types the ssh command without running it (default true).
#AUTORUN_SSH=true

# "true" enables the YubiKey via yubiswitch before the bastion login (default false).
#YUBISWITCH=false
